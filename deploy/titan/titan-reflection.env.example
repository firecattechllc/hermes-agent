# Titan governed dynamic reflection scheduler configuration.
#
# Copy to /etc/hermes-prime/titan-reflection.env (mode 0600, owned by the
# `hermes` service user) and fill in real values. Never commit a populated
# copy.
#
# This file is loaded ALONGSIDE omniroute.env (titan_reflection_entrypoint
# also loads HERMES_OMNIROUTE_* / HERMES_TITAN_OLLAMA_* / HERMES_FREELLMAPI_*
# via TitanRoutingConfig.from_env() -- both env files should be present in
# the same EnvironmentFile= search path, or merged, per your systemd setup).

# ── Dynamic wake-up clock (hermes_cli.prime.titan_scheduler.SchedulerPolicy) ─

# Enforced hard bounds (a model's own wake proposal is always clamped into
# this range -- it can never set its own timing directly).
HERMES_TITAN_SCHEDULER_MIN_WAKE_SECONDS=300
HERMES_TITAN_SCHEDULER_MAX_WAKE_SECONDS=21600
# Ceiling on how long a single reflection cycle may run before systemd's own
# TimeoutStartSec= (see titan-reflection.service) kills it.
HERMES_TITAN_SCHEDULER_MAX_RUNTIME_SECONDS=600
# After this many consecutive failed cycles, Titan stays parked until an
# operator or health signal clears the streak.
HERMES_TITAN_SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
# Ceiling on reflection cycles per day (resets at UTC midnight).
HERMES_TITAN_SCHEDULER_DAILY_CYCLE_BUDGET=96
# Optional: ceiling on total spend (micros) routed to external/paid
# providers per day. Blank means no ceiling (both governed providers today,
# Titan Ollama and FreeLLMAPI, are free).
HERMES_TITAN_SCHEDULER_DAILY_EXTERNAL_BUDGET_MICROS=
# Cooldown enforced after thermal or resource pressure is detected, before
# Titan will wake again for anything other than a hard trigger.
HERMES_TITAN_SCHEDULER_COOLDOWN_SECONDS=900

# ── Persistent state and queue ───────────────────────────────────────────────

# Root directory for the persistent task queue, scheduler state, and idle
# model tracking. Must be a Titan-local path (never /Users/... or a Mac
# path) with mode 0700, owned by the `hermes` service user.
HERMES_TITAN_REFLECTION_STATE_ROOT=/var/lib/hermes-prime/titan-reflection

# How long (seconds) a Titan Ollama model may sit idle before this cycle
# asks Ollama to unload it (keep_alive=0). Models load again automatically
# on next use -- there is no persistent inference process to keep warm.
HERMES_TITAN_IDLE_MODEL_THRESHOLD_SECONDS=600

HERMES_TITAN_REFLECTION_LOG_LEVEL=INFO
