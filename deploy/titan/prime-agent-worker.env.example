# Hermes governed Prime Agent worker — environment template for Titan.
#
# Copy to /etc/hermes-prime-agent-worker/worker.env (root:hermes-prime-agent,
# mode 0640) and fill in real values. Never commit a populated copy of this
# file. The auth token for HERMES_PRIME_AGENT_WORKER_PROVIDER routing lives
# in Prime Agent's own ~/.prime/agent/models.json (0600, owned by
# hermes-prime-agent), not here — see the installation runbook for how it
# is provisioned without ever printing the token to a terminal transcript.

HERMES_PRIME_AGENT_WORKER_EXECUTABLE=/var/lib/hermes-prime-agent/.local/share/prime-agent-node/current/bin/prime-agent
HERMES_PRIME_AGENT_WORKER_NODE_BIN_DIR=/var/lib/hermes-prime-agent/.local/share/prime-agent-node/current/bin
HERMES_PRIME_AGENT_WORKER_HOME_DIR=/var/lib/hermes-prime-agent

# Comma-separated absolute paths. Only these directories may be used as a
# session --cwd. Keep this to specific project checkouts, never a home
# directory or filesystem root.
HERMES_PRIME_AGENT_WORKER_WORKSPACE_ALLOWLIST=/var/lib/hermes-prime-agent/workspace/acceptance-test-repo

HERMES_PRIME_AGENT_WORKER_STATE_DIR=/var/lib/hermes-prime-agent/state
HERMES_PRIME_AGENT_WORKER_CACHE_DIR=/var/lib/hermes-prime-agent/cache
HERMES_PRIME_AGENT_WORKER_LOG_DIR=/var/lib/hermes-prime-agent/logs
HERMES_PRIME_AGENT_WORKER_XDG_DATA_HOME=/var/lib/hermes-prime-agent/.local/share

# Titan-local governed model routing (OmniRoute). See
# docs/hermes-prime-agent-worker/architecture.md for why this is currently
# blocked and what "provider_active=true" requires before it is safe to
# flip.
HERMES_PRIME_AGENT_WORKER_PROVIDER=titan-omniroute
HERMES_PRIME_AGENT_WORKER_MODEL=lightweight
HERMES_PRIME_AGENT_WORKER_PROVIDER_ACTIVE=false

HERMES_PRIME_AGENT_WORKER_MAX_TURNS=6
HERMES_PRIME_AGENT_WORKER_MAX_TOKENS=20000
HERMES_PRIME_AGENT_WORKER_TIMEOUT_SECONDS=300
HERMES_PRIME_AGENT_WORKER_GATE_RETRIES=1
HERMES_PRIME_AGENT_WORKER_GATE_TIMEOUT_SECONDS=60
HERMES_PRIME_AGENT_WORKER_MAX_OUTPUT_BYTES=200000
HERMES_PRIME_AGENT_WORKER_MAX_CONCURRENT_SESSIONS=1

# Empty by default => --no-tools (read-only inspection). Fill in real
# Prime Agent built-in/extension tool names from its own docs before
# enabling anything here.
HERMES_PRIME_AGENT_WORKER_ALLOWED_TOOLS=
# Tools permitted only when a run is explicitly invoked with
# --approve-mutation. Leave empty until filesystem-mutation tools are
# actually needed and reviewed.
HERMES_PRIME_AGENT_WORKER_MUTATION_TOOLS=

HERMES_PRIME_AGENT_WORKER_ALLOWED_NETWORK_ENDPOINTS=http://127.0.0.1:8791

HERMES_PRIME_AGENT_WORKER_EVIDENCE_RETENTION_DAYS=30
HERMES_PRIME_AGENT_WORKER_EVIDENCE_MAX_FILES=500
HERMES_PRIME_AGENT_WORKER_COOLDOWN_SECONDS_AFTER_FAILURE=30
HERMES_PRIME_AGENT_WORKER_MAX_CONSECUTIVE_FAILURES_BEFORE_COOLDOWN=3

HERMES_PRIME_AGENT_WORKER_LOG_LEVEL=INFO
