# Titan node environment configuration (Raspberry Pi 5, always-on).
#
# Copy to /etc/hermes/titan.env (or ~/.hermes/.env if running as a user
# service) with mode 0600, owned by the service user. Fill in real values.
# Never commit a populated copy of this file.
#
# Titan's role per the target architecture: messaging gateway, scheduler and
# automations, lightweight orchestration, persistent memory/knowledge
# services, notifications, fleet coordination and health checks.
#
# This file documents ONLY what is specific to Titan's role. The full,
# canonical list of every environment variable Hermes understands (LLM
# providers, tool API keys, terminal/browser backend config, etc.) lives in
# the repository root's .env.example — reference it for anything not listed
# here.

# ── GitHub (source of truth) ─────────────────────────────────────────────
# Required for `hermes skills` GitHub-tap install/publish and any git-backed
# workflow. Generate at https://github.com/settings/tokens (fine-grained,
# minimum required scopes only).
GITHUB_TOKEN=

# ── Telegram (first phone control + approval surface) ───────────────────
# From @BotFather. Required for the Telegram gateway, phone approval
# prompts, and job completion/failure notifications to be reachable.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control this Hermes
# instance. Leave TELEGRAM_ALLOW_ALL_USERS unset/false — an open gateway on
# an always-on node is a real risk.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false
# Optional: a channel/group ID Hermes treats as its default home channel.
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=

# ── Hermes Link (Mac/Titan governed communication) ───────────────────────
# Simple bearer-token path (recommended for initial setup — see
# deploy/titan/README.md for the hardened signed-registry alternative).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_LINK_TOKEN=

# ── Terminal tool backend ─────────────────────────────────────────────────
# Titan is a single-purpose always-on Pi; "local" is the recommended default
# so scheduled/gateway-triggered commands run directly without an extra
# container layer. Change only if you have a specific isolation need.
TERMINAL_ENV=local

# ── Optional: cloud model fallback (approved provider only) ─────────────
# Leave unset to force local-first routing (Titan/Mac Ollama) with no cloud
# fallback. Set only the ONE approved provider this deployment authorizes.
# See root .env.example's "LLM PROVIDER" sections for the full list.
# OPENROUTER_API_KEY=
