[Unit]
Description=Titan documentation worker — weekly contradiction/provenance audit
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-docs
Group=hermes-docs
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/hermes/docs-worker.env
ExecStart=/opt/hermes/venv/bin/python -m hermes_docs_worker weekly
TimeoutStartSec=660
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryMax=512M
CPUQuota=50%
TasksMax=32
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/hermes-docs-worker /opt/hermes-docs/hydra-docs
UMask=0077

[Install]
WantedBy=multi-user.target
