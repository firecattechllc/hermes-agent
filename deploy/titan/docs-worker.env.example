# Titan documentation worker configuration.
#
# Copy to /etc/hermes/docs-worker.env (mode 0600, owned by the `hermes-docs`
# service user). Never commit a populated copy.
#
# Validated at every invocation by hermes_docs_worker.config.DocsWorkerConfig.
# Any value that references a Mac Tailscale address, Mac hostname,
# /Users/... path, or host.docker.internal is rejected before any collector,
# generator, or git operation runs.

# ── Hermes source (discovered, not assumed) ─────────────────────────────────

# The absolute path to the Hermes checkout actually running on this Titan
# node. Do not guess this -- read it from your real deployment (e.g. the
# ExecStart WorkingDirectory of the Hermes systemd unit, or wherever your
# install runbook placed it) and set it explicitly here.
HERMES_DOCS_WORKER_HERMES_SOURCE_DIR=

# ── Documentation vault checkout ─────────────────────────────────────────────

HERMES_DOCS_WORKER_DOCS_REPO_PATH=/opt/hermes-docs/hydra-docs
HERMES_DOCS_WORKER_STATE_DIR=/var/lib/hermes-docs-worker

# owner/repo slug. GitHub remains canonical -- this worker only ever opens a
# PR against this repo; it never merges, never pushes to main, and never
# deletes a remote branch.
HERMES_DOCS_WORKER_GITHUB_REPO=firecattechllc/hydra-docs
HERMES_DOCS_WORKER_GIT_REMOTE=origin
HERMES_DOCS_WORKER_MAIN_BRANCH=main
HERMES_DOCS_WORKER_GIT_USER_NAME=Titan Docs Worker
HERMES_DOCS_WORKER_GIT_USER_EMAIL=titan-docs-worker@hermes.local

# ── Local model (prose generation) ───────────────────────────────────────────

# Titan-local Ollama only -- never a Mac address. If unreachable, the worker
# falls back to a deterministic, prose-free generator; evidence collection
# and Markdown structure are unaffected either way.
HERMES_DOCS_WORKER_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# An official Gemma tag actually pulled on this node (see
# docs/hermes-docs-worker/runbook.md for `ollama pull` guidance sized for a
# Pi 5).
HERMES_DOCS_WORKER_OLLAMA_MODEL=gemma3:4b
HERMES_DOCS_WORKER_OLLAMA_TIMEOUT_SECONDS=30

# ── Explicit allowlists ───────────────────────────────────────────────────────

# Comma-separated systemd unit names this worker may query with
# `systemctl show`. No other unit name is ever queried, and there is no
# discovery/list-units code path.
HERMES_DOCS_WORKER_SYSTEMD_ALLOWLIST=hermes-docs-evidence.service,hermes-docs-daily.service,hermes-docs-weekly.service,ollama.service

# Comma-separated additional absolute paths (beyond the three above) a
# collector or generator may touch. Leave blank unless you have a specific,
# narrow reason to extend the filesystem allowlist.
HERMES_DOCS_WORKER_EXTRA_FILESYSTEM_ALLOWLIST=

# Natural keys (as registered in the Prime fleet registry) this worker
# reports status for.
HERMES_DOCS_WORKER_FLEET_NODE_KEYS=prime,mac,hydra_live

# ── Budgets and limits (Pi5-appropriate defaults) ────────────────────────────

HERMES_DOCS_WORKER_MAX_DIFF_BYTES=200000
HERMES_DOCS_WORKER_MAX_FILES_CHANGED=25
# Minimum seconds between two automation PRs this worker opens.
HERMES_DOCS_WORKER_MIN_PR_INTERVAL_SECONDS=21600
# Wall-clock ceiling for one worker run (collect/daily/weekly).
HERMES_DOCS_WORKER_MAX_RUN_SECONDS=600
# Ceiling for any single subprocess (git/gh/systemctl) call.
HERMES_DOCS_WORKER_MAX_SUBPROCESS_SECONDS=30
HERMES_DOCS_WORKER_EVIDENCE_RETENTION_DAYS=30
HERMES_DOCS_WORKER_EVIDENCE_MAX_FILES=500

HERMES_DOCS_WORKER_PR_LABELS=automation,titan-docs

# Optional: a JSON file a separate test runner writes with
# {"passed": true, "run_at": "..."}. The worker only ever reads this file;
# it never runs tests itself. Leave blank to skip local test evidence.
HERMES_DOCS_WORKER_HERMES_TEST_EVIDENCE_PATH=

# Additional Mac Tailscale addresses/hostnames to always reject beyond the
# built-in default set, comma-separated. Extends, never replaces, the
# built-in list.
HERMES_DOCS_WORKER_FORBIDDEN_MAC_ADDRESSES=

HERMES_DOCS_WORKER_LOG_LEVEL=INFO

# ── GitHub authentication ─────────────────────────────────────────────────────

# Preferred: run `gh auth login` once as the hermes-docs service user during
# install instead of setting this. Only set GH_TOKEN here if you specifically
# want a scoped PAT instead of gh's own credential store -- if you do, treat
# this exactly like every other secret in this file: NEVER commit a
# populated value.
GH_TOKEN=
