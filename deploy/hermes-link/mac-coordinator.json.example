{
  "enabled": false,
  "coordinator_node_id": "node-mac",
  "credential_registry_path": "/Users/operator/Library/Application Support/Hermes/link/credentials.json",
  "targets": [
    {
      "node_id": "node-titan",
      "authenticated_identity_ref": "tailnet-node:replace-with-verified-reference",
      "tailnet_dns_identity": "replace-with-verified-titan.ts.net",
      "base_url": "http://127.0.0.1:19320"
    },
    {
      "node_id": "node-prime",
      "authenticated_identity_ref": "tailnet-node:replace-with-verified-reference",
      "tailnet_dns_identity": "replace-with-verified-prime.ts.net",
      "base_url": "http://127.0.0.1:19321"
    }
  ]
}
