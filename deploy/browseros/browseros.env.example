# Governed Hermes browser capability. Disabled until operator review is complete.
HERMES_BROWSER_ENABLED=false
HERMES_BROWSER_PROVIDER=browseros
HERMES_BROWSER_TRANSPORT=streamable_http
HERMES_BROWSER_ENDPOINT=http://127.0.0.1:9239/mcp
HERMES_BROWSER_PROFILE=/var/lib/hermes-browseros/home
HERMES_BROWSER_CONNECT_TIMEOUT=10
HERMES_BROWSER_TOOL_TIMEOUT=30

# External BrowserOS container. Do not place credentials here.
BROWSEROS_IMAGE=hermes-browseros:148.0.7966.97
BROWSEROS_PROFILE=/var/lib/hermes-browseros/home
