# FireCat Hermes deployment — master secrets/credential template.
#
# Every variable below is a PLACEHOLDER. Copy what you need into
# deploy/titan/titan.env.example, deploy/mac/mac.env.example, or
# ~/.hermes/.env — never commit a populated copy of this file, and never
# fill in real values here.
#
# Cross-reference: docs/capability-manifest.yaml. Each section header names
# the manifest `key` it corresponds to, so you can look up exactly which
# capability a variable unlocks and its current activation state.

# ============================================================================
# ENABLED FOR THIS DEPLOYMENT (Phase 3 core surface)
# ============================================================================

# manifest key: telegram_gateway, telegram_approval_prompts, notifications_job_status
# First phone control + approval surface. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Do not leave both this AND
# TELEGRAM_ALLOW_ALL_USERS empty/true at once — that's an open gateway.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false

# manifest key: hermes_link_titan_node, hermes_link_mac_node
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_LINK_TOKEN=

# manifest key: (source-of-truth requirement, all deployments)
# Fine-grained GitHub PAT, minimum required scopes only.
GITHUB_TOKEN=

# ============================================================================
# PREPARED BUT CREDENTIAL-GATED — DO NOT SET UNLESS YOU INTEND TO ENABLE
# ============================================================================

# manifest key: discord_gateway
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS=

# manifest key: slack_gateway
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=

# manifest key: whatsapp_gateway (official Meta Cloud API path)
# See hermes_cli/setup_whatsapp_cloud.py for the full credential set.
# WHATSAPP_ENABLED=

# manifest key: signal_gateway (requires a running signal-cli HTTP daemon)
# SIGNAL_HTTP_URL=
# SIGNAL_ACCOUNT=

# manifest key: email_gateway
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_IMAP_HOST=

# manifest key: calendar_integration (via the Google Workspace skill, OAuth)
# See skills/productivity/google-workspace/setup.py.

# manifest key: spotify_integration
# See plugins/spotify/plugin.yaml for the full OAuth credential set.

# manifest key: image_generation
# FAL_KEY=

# manifest key: voice_tts_cloud (any one is sufficient; Edge TTS/local
# providers already work with none of these set — see voice_tts_local)
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# MINIMAX_API_KEY=

# manifest key: browser_automation_cloud (local Chromium needs none of these)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSER_USE_API_KEY=

# ============================================================================
# APPROVED CLOUD MODEL FALLBACK (optional — leave unset for local-first only)
# ============================================================================
# Set at most ONE provider here to keep the fallback surface auditable. See
# the root .env.example's "LLM PROVIDER" sections for the full list of
# supported providers and their exact variable names.
# OPENROUTER_API_KEY=
