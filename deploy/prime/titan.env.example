# Hermes Titan worker service configuration.
#
# Copy to /etc/hermes-prime/titan.env (mode 0600, owned by the `hermes`
# service user) and fill in real values. Never commit a populated copy.
#
# Validated at startup by hermes_cli.prime.entrypoints.WorkerServiceConfig.

# Prime's control-plane base URL, reachable over Tailscale, e.g.
# http://<prime-tailscale-hostname>:8743
HERMES_PRIME_BASE_URL=

# Must match Prime's HERMES_PRIME_AUTH_TOKEN exactly.
HERMES_PRIME_AUTH_TOKEN=

# This node's own reachable endpoint, recorded in the fleet registry so
# other governed callers know where to route Titan-targeted work.
HERMES_TITAN_ENDPOINT=http://<titan-tailscale-hostname>:11434

# Comma-separated declared capabilities. Must be drawn from the closed set
# in hermes_cli.prime.fleet_registry.KNOWN_FLEET_CAPABILITIES.
HERMES_TITAN_CAPABILITIES=worker_heartbeat,local_model_inference,sentiment_analysis

# Reported software version and Prime protocol version (integer).
HERMES_TITAN_SOFTWARE_VERSION=1.0.0
HERMES_TITAN_PROTOCOL_VERSION=1

# How often (seconds) this node sends a heartbeat to Prime.
HERMES_TITAN_HEARTBEAT_INTERVAL_SECONDS=30

# Titan's local Ollama endpoint, used to report real model inventory and
# readiness on every heartbeat. Leave blank to send liveness-only
# heartbeats without a model inventory (readiness will still report READY;
# this is intended for a Titan node that does not run local inference).
HERMES_TITAN_OLLAMA_ENDPOINT=http://127.0.0.1:11434
HERMES_TITAN_OLLAMA_TIMEOUT_MS=5000

HERMES_PRIME_LOG_LEVEL=INFO
