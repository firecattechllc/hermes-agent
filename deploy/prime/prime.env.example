# Hermes Prime control-plane service configuration.
#
# Copy to /etc/hermes-prime/prime.env (mode 0600, owned by the `hermes`
# service user) and fill in real values. Never commit a populated copy of
# this file — it is loaded via `EnvironmentFile=` in prime.service.
#
# Validated at startup by hermes_cli.prime.entrypoints.PrimeServiceConfig.
# The process refuses to start if a required variable is missing, blank, or
# fails validation (e.g. a wildcard bind host or a short auth token).

# Absolute path to Prime's durable state root (fleet registry, heartbeat
# health store, evidence journal). Must be an absolute path on persistent
# local storage, not a network share.
HERMES_PRIME_STATE_ROOT=/var/lib/hermes-prime

# The Prime node's own Tailscale hostname or IP address (e.g. from
# `tailscale ip -4`). Must NOT be 0.0.0.0 or blank — the server refuses to
# bind to a wildcard address.
HERMES_PRIME_BIND_HOST=

# TCP port the control-plane HTTP API listens on.
HERMES_PRIME_BIND_PORT=8743

# Shared bearer token Titan/Mac use to authenticate to Prime. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 16 characters. Treat this like a credential: do not log
# it, do not commit it, rotate it if it may have leaked.
HERMES_PRIME_AUTH_TOKEN=

# Mission Control / evidence project identifier for this fleet.
HERMES_PRIME_PROJECT_ID=hermes-fleet

# How often (seconds) the control-plane loop re-verifies its evidence
# journal's hash-chain integrity. This is a lightweight liveness/integrity
# check, not full fleet certification — see HERMES_PRIME_CERTIFICATION_*
# below for that.
HERMES_PRIME_INTEGRITY_CHECK_INTERVAL_SECONDS=300

# Per-node governed Ollama model-alias configuration, as a JSON object:
#   {"<natural_key>": {"<alias>": "<concrete ollama model tag>"}}
# Drives both POST /v1/sigil/route dispatch and GET /v1/fleet/nodes model
# resolution. A node with no entry here has no governed dispatch route at
# all, regardless of what it reports installed on its own heartbeat — an
# alias must be positively configured by the Prime operator, never inferred
# from a node's self-reported inventory. See hermes_cli.prime.sigil_routing
# .DEFAULT_OPERATION_ROUTES for which aliases each Sigil operation requires
# (currently: titan -> "sentiment", mac -> "primary_reasoning").
# Example:
#   HERMES_PRIME_NODE_MODEL_ALIASES={"titan":{"sentiment":"qwen3:0.6b"},"mac":{"primary_reasoning":"qwen3:1.7b"}}
HERMES_PRIME_NODE_MODEL_ALIASES=

# How often (seconds) Prime runs a real hermes_cli.prime.certification_cli
# .run_certification() pass (identity/event/health/admission/sigil-contract/
# remote-maintenance selftests, live-runtime selftests, real evidence-chain
# and fleet-registry inspection, optionally Stage 1 regression) and caches
# the result for GET /v1/fleet/certification and every admission decision
# POST /v1/sigil/route makes. Also runs once immediately at startup, off the
# request-serving thread.
HERMES_PRIME_CERTIFICATION_INTERVAL_SECONDS=1800

# Skip the Stage 1 regression scripts (apps/sigil/scripts/verify_*.py) during
# each certification pass. Those scripts import the `sigil` package and are
# slow (subprocess); leave this false in production so certification reflects
# a real Stage 1 check, not merely the live-runtime selftests. Only useful
# for a minimal Prime deployment that never installed the apps/sigil venv.
HERMES_PRIME_CERTIFICATION_SKIP_STAGE1=false

# Optional: Python stdlib logging level (DEBUG, INFO, WARNING, ERROR).
HERMES_PRIME_LOG_LEVEL=INFO
