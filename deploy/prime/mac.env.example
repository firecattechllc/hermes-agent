# Hermes Mac worker service configuration.
#
# Referenced from the launchd plist (com.hermes.mac-worker.plist.example)
# via `EnvironmentVariables`, or sourced by a wrapper shell script before
# exec'ing the service. Never commit a populated copy of this file.
#
# Validated at startup by hermes_cli.prime.entrypoints.WorkerServiceConfig.

# Prime's control-plane base URL, reachable over Tailscale.
HERMES_PRIME_BASE_URL=

# Must match Prime's HERMES_PRIME_AUTH_TOKEN exactly.
HERMES_PRIME_AUTH_TOKEN=

# This node's own reachable endpoint.
HERMES_MAC_ENDPOINT=http://<mac-tailscale-hostname>:11434

# Comma-separated declared capabilities, drawn from the closed set in
# hermes_cli.prime.fleet_registry.KNOWN_FLEET_CAPABILITIES. `desktop_use`
# is what admits this node into hermes_cli.prime.desktop_governance.
HERMES_MAC_CAPABILITIES=worker_heartbeat,local_model_inference,embeddings,desktop_use

HERMES_MAC_SOFTWARE_VERSION=1.0.0
HERMES_MAC_PROTOCOL_VERSION=1
HERMES_MAC_HEARTBEAT_INTERVAL_SECONDS=30

# Mac's local Ollama endpoint (loopback-only by Sigil's own governance
# convention — see apps/sigil/src/sigil/ai/mac_ollama.py).
HERMES_MAC_OLLAMA_ENDPOINT=http://127.0.0.1:11434
HERMES_MAC_OLLAMA_TIMEOUT_MS=5000

HERMES_PRIME_LOG_LEVEL=INFO
