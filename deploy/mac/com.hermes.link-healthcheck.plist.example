<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional Mac-side periodic fleet health check.

  The Mac is NOT required to run a persistent listening service for Hermes
  Link — it acts as the coordinator (big_sister), invoking `hermes link`
  on demand, and the target architecture explicitly allows it to be offline
  without breaking Titan. This plist is an OPTIONAL convenience: a periodic,
  read-only connectivity check that logs Titan reachability so an operator
  can see at a glance (via the log file) whether the link would currently
  work, without that check blocking or being required for anything else.

  Copy to ~/Library/LaunchAgents/com.hermes.link-healthcheck.plist. Replace
  every REPLACE_ME_* placeholder. Never commit a populated copy.

  Load with:   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hermes.link-healthcheck.plist
  Unload with: launchctl bootout gui/$(id -u)/com.hermes.link-healthcheck
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.link-healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_ME_ABSOLUTE_PATH_TO_VENV/bin/python</string>
        <string>REPLACE_ME_ABSOLUTE_PATH_TO_HERMES_CHECKOUT/scripts/fleet_connectivity_check.py</string>
        <string>--node</string>
        <string>titan</string>
        <string>--config</string>
        <string>REPLACE_ME_ABSOLUTE_PATH_TO_HERMES_CHECKOUT/deploy/mac/mac-coordinator.json</string>
        <string>--json</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPLACE_ME_ABSOLUTE_PATH_TO_HERMES_CHECKOUT</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>REPLACE_ME_LOG_DIR/link-healthcheck.out.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_ME_LOG_DIR/link-healthcheck.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
